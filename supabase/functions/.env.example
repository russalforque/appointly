# Server-side only — set with `supabase secrets set --env-file supabase/functions/.env.example`
# (after filling in real values). Never prefix these with VITE_ or reference them from src/.
XENDIT_SECRET_KEY=xnd_development_xxx
XENDIT_CALLBACK_TOKEN=xxx
PUBLIC_SITE_URL=http://localhost:5173

# Optional: restrict the hosted invoice to specific channels. Leave unset to show every
# channel activated on the Xendit account. e.g. CREDIT_CARD,GCASH,PAYMAYA,GRABPAY,QRPH
# XENDIT_PAYMENT_METHODS=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are already provided
# automatically to Edge Functions by the Supabase runtime — do not set them here.
