# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# Both values are public by design: they are compiled into the browser bundle, and access is
# decided by Row Level Security, not by holding the key. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
